/// The original chat and session list: a swipe-over drawer on compact windows,
/// a rail or sidebar and optional conversation detail column on wide windows.
class HomeShell extends ConsumerStatefulWidget {
  const HomeShell({
    super.key,
    this.onDisconnect,
    this.onOpenEngine,
    this.chatBuilder,
    this.initiallyOpen = false,
  });

  /// Owned by the iOS entry point, which also owns the native Host lifecycle.
  final VoidCallback? onDisconnect;

  /// Optional iOS engine details; no donor destination can be opened here.
  final VoidCallback? onOpenEngine;

  /// Replaces [ChatScreen] in drawer gesture tests.
  @visibleForTesting
  final Widget Function(VoidCallback openDrawer)? chatBuilder;

  @visibleForTesting
  final bool initiallyOpen;

  @override
  ConsumerState<HomeShell> createState() => _HomeShellState();
}

class _HomeShellState extends ConsumerState<HomeShell> with SingleTickerProviderStateMixin {
  late final AnimationController _drawer = AnimationController(
    vsync: this,
    duration: AppMotion.emphasized,
    value: widget.initiallyOpen ? 1 : 0,
  );

  // PopScope and the chat semantics only rebuild on the 0 ↔ >0 transition.
  late bool _open = widget.initiallyOpen;
  final _identityBar = ValueNotifier<double>(0);
  AdaptiveLayout _layout = const AdaptiveLayout.compact();

  @override
  void initState() {
    super.initState();
    _drawer.addListener(() {
      final open = _drawer.value > 0;
      if (open == _open) return;
      setState(() => _open = open);
      if (!open && _layout.left != LeftPane.sidebar) {
        ref.read(drawerSelectionProvider.notifier).end();
      }
    });
  }

  @override
  void dispose() {
    _drawer.dispose();
    _identityBar.dispose();
    super.dispose();
  }

  double _drawerWidth(BuildContext context) => math.max(
    0.0,
    math.min(
      AdaptiveMetrics.sidebarWidth + MediaQuery.paddingOf(context).left,
      MediaQuery.sizeOf(context).width - 56,
    ),
  );

  void _openDrawer() {
    FocusManager.instance.primaryFocus?.unfocus();
    _drawer.animateTo(1, curve: AppMotion.glide, duration: AppMotion.of(context, AppMotion.emphasized));
  }

  void _closeDrawer() {
    FocusManager.instance.primaryFocus?.unfocus();
    _drawer.animateBack(0, curve: AppMotion.glide, duration: AppMotion.of(context, AppMotion.standard));
  }

  void _onMenu() {
    switch (_layout.menuAction) {
      case MenuAction.overlay:
        _openDrawer();
      case MenuAction.expand:
        ref.read(layoutPrefsProvider.notifier).setSidebarOpen(true);
      case MenuAction.collapse:
        ref.read(layoutPrefsProvider.notifier).setSidebarOpen(false);
    }
  }

  Future<void> _search() async {
    final sessionId = await showSessionSearch(context);
    if (sessionId != null && mounted) ref.read(currentSessionProvider.notifier).select(sessionId);
  }

  void _openDestination(DrawerDestination destination) {
    final openEngine = widget.onOpenEngine;
    if (destination != DrawerDestination.engine || openEngine == null) return;
    if (_open && _layout.left != LeftPane.sidebar) _closeDrawer();
    openEngine();
  }

  void _onDragStart() {
    _drawer.stop();
    FocusManager.instance.primaryFocus?.unfocus();
  }

  void _onDragDelta(double dx) {
    final width = _drawerWidth(context);
    if (width > 0) _drawer.value = (_drawer.value + dx / width).clamp(0.0, 1.0);
  }

  void _onDragEnd(double velocity) {
    final width = _drawerWidth(context);
    if (velocity.abs() >= kMinFlingVelocity && width > 0) {
      final target = velocity > 0 ? 1.0 : 0.0;
      if (AppMotion.reduced(context)) {
        _drawer.value = target;
        return;
      }
      final spring = AppMotion.settle(AppMotion.flingSpring, _drawer.value, target, velocity / width, landing: false);
      if (velocity > 0) {
        _drawer.animateWith(spring);
      } else {
        _drawer.animateBackWith(spring);
      }
    } else if (_drawer.value >= 0.5) {
      _openDrawer();
    } else {
      _closeDrawer();
    }
  }

  Map<Type, GestureRecognizerFactory> get _drawerGestures => {
    DrawerDragRecognizer: GestureRecognizerFactoryWithHandlers<DrawerDragRecognizer>(
      () => DrawerDragRecognizer(
        isOpen: () => _drawer.value > 0,
        onStart: _onDragStart,
        onDelta: _onDragDelta,
        onEnd: _onDragEnd,
        debugOwner: this,
      ),
      (_) {},
    ),
  };

  @override
  Widget build(BuildContext context) {
    final width = _drawerWidth(context);
    final sessionId = ref.watch(currentSessionProvider);
    final prefs = ref.watch(layoutPrefsProvider);
    final selection = ref.watch(drawerSelectionProvider);
    final wasSidebar = _layout.left == LeftPane.sidebar;
    final layout = _layout = AdaptiveLayout.resolve(
      window: MediaQuery.sizeOf(context),
      padding: MediaQuery.paddingOf(context),
      hasSession: sessionId != null,
      sidebarOpen: prefs.sidebarOpen,
      panelOpen: prefs.panelOpen,
    );
    final sidebar = layout.left == LeftPane.sidebar;
    final overlayOpen = !sidebar && _open;
    if (sidebar && _open) {
      // Rotation or a detail-panel fold made the permanent list fit. Retire
      // the overlay without replacing the chat or ending sidebar selection.
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (mounted && _layout.left == LeftPane.sidebar) _drawer.value = 0;
      });
    } else if (wasSidebar && !sidebar && selection != null) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (mounted && _layout.left != LeftPane.sidebar && identical(ref.read(drawerSelectionProvider), selection)) {
          ref.read(drawerSelectionProvider.notifier).end();
        }
      });
    }
    final chat = widget.chatBuilder?.call(_onMenu) ?? ChatScreen(onOpenDrawer: _onMenu, backdrop: false);
    final showEngineEntry = widget.onOpenEngine != null;
    return PopScope(
      canPop: !overlayOpen && !(selection != null && sidebar),
      onPopInvokedWithResult: (didPop, _) {
        if (didPop) return;
        final controller = ref.read(drawerSelectionProvider.notifier);
        if (controller.active && (sidebar || overlayOpen)) {
          controller.end();
        } else if (overlayOpen) {
          _closeDrawer();
        }
      },
      child: AnnotatedRegion<SystemUiOverlayStyle>(
        value: dshSystemOverlay(Theme.of(context).brightness),
        child: AppBackdrop(
          child: _DrawerNoticeTheme(
            drawer: _drawer,
            identityBar: _identityBar,
            width: width,
            child: Scaffold(
              backgroundColor: Colors.transparent,
              // The actual chat screen handles keyboard insets itself.
              resizeToAvoidBottomInset: false,
              body: Stack(
                fit: StackFit.expand,
                children: [
                  ExcludeSemantics(
                    excluding: overlayOpen,
                    child: _DrawerParallax(
                      animation: _drawer,
                      width: sidebar ? 0 : width,
                      child: AdaptiveScaffold(
                        layout: layout,
                        animate: prefs.loaded,
                        body: RawGestureDetector(
                          // Join the hit chain without swallowing taps or vertical scrolling.
                          // Only the chat column participates; the detail tabs own their swipes.
                          behavior: HitTestBehavior.translucent,
                          gestures: sidebar ? const {} : _drawerGestures,
                          child: chat,
                        ),
                        sidebar: SessionsDrawer(
                          key: const ValueKey('persistent-sidebar'),
                          onClose: () {},
                          onOpen: _openDestination,
                          showEngineEntry: showEngineEntry,
                          onDisconnect: widget.onDisconnect,
                        ),
                        rail: _SessionRail(
                          onMenu: _onMenu,
                          menuTooltip: AdaptiveChrome.menuTooltipFor(layout),
                          onSearch: _search,
                        ),
                        panel: layout.panelAvailable && sessionId != null
                            ? SessionDetailPage.panel(key: ValueKey(sessionId), sessionId: sessionId)
                            : null,
                      ),
                    ),
                  ),
                  if (!sidebar)
                    Positioned.fill(
                      child: RawGestureDetector(
                        behavior: HitTestBehavior.deferToChild,
                        gestures: _drawerGestures,
                        child: _DrawerOverlay(
                          animation: _drawer,
                          width: width,
                          drawer: SessionsDrawer(
                            onClose: _closeDrawer,
                            onOpen: _openDestination,
                            showEngineEntry: showEngineEntry,
                            onDisconnect: widget.onDisconnect,
                            identityBarHeight: _identityBar,
                            drawerMotion: _drawer,
                          ),
                          onClose: _closeDrawer,
                        ),
                      ),
                    ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}

/// The session keys from the donor rail, aligned with the chat header. No
/// host switcher or secondary destinations are mounted in the iOS rail.
class _SessionRail extends StatelessWidget {
  const _SessionRail({required this.onMenu, required this.menuTooltip, required this.onSearch});

  final VoidCallback onMenu;
  final String menuTooltip;
  final VoidCallback onSearch;

  @override
  Widget build(BuildContext context) => Padding(
    padding: EdgeInsets.fromLTRB(
      MediaQuery.paddingOf(context).left + AdaptiveMetrics.edge,
      MediaQuery.paddingOf(context).top + (ChatHeader.barHeightOf(context) - AdaptiveMetrics.key) / 2,
      AdaptiveMetrics.edge,
      0,
    ),
    child: BackdropGroup(
      child: Align(
        alignment: Alignment.topCenter,
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            GlassIconButton(key: const ValueKey('rail-menu'), icon: AppIcons.menu, tooltip: menuTooltip, onPressed: onMenu),
            const SizedBox(height: AdaptiveMetrics.gap),
            GlassIconButton(
              key: const ValueKey('rail-search'),
              icon: AppIcons.search,
              tooltip: context.l10n.shellSearchChats,
              onPressed: onSearch,
            ),
          ],
        ),
      ),
    ),
  );
}

/// Floating notices follow the drawer above the identity or selection bar.
class _DrawerNoticeTheme extends StatelessWidget {
  const _DrawerNoticeTheme({required this.drawer, required this.identityBar, required this.width, required this.child});

  final Animation<double> drawer;
  final ValueListenable<double> identityBar;
  final double width;
  final Widget child;

  @override
  Widget build(BuildContext context) {
    final base = SnackBarTheme.of(context);
    final closed = base.insetPadding;
    final screen = MediaQuery.sizeOf(context).width;
    final padding = MediaQuery.paddingOf(context);
    return AnimatedBuilder(
      animation: Listenable.merge([drawer, identityBar]),
      child: child,
      builder: (context, child) {
        final progress = drawer.value;
        var data = base;
        if (closed != null && progress > 0 && identityBar.value > 0) {
          final open = EdgeInsets.fromLTRB(
            SessionsDrawer.contentEdge,
            closed.top,
            math.max(0.0, screen - padding.right - width + SessionsDrawer.contentEdge),
            identityBar.value + composerToastGap,
          );
          data = base.copyWith(insetPadding: EdgeInsets.lerp(closed, open, progress));
        }
        return SnackBarTheme(data: data, child: child!);
      },
    );
  }
}

/// On the fluid tier the underlying page drifts with the drawer without being
/// re-laid-out or rebuilt on each tick.
class _DrawerParallax extends StatelessWidget {
  const _DrawerParallax({required this.animation, required this.width, required this.child});

  final Animation<double> animation;
  final double width;
  final Widget child;

  @override
  Widget build(BuildContext context) {
    final fluid = AppMotion.fluid(context);
    return AnimatedBuilder(
      animation: animation,
      child: child,
      builder: (context, child) => Transform.translate(
        offset: Offset(fluid ? 0.14 * animation.value * width : 0, 0),
        child: child,
      ),
    );
  }
}

/// Donor scrim and paint-only drawer translation: the hidden overlay keeps
/// its state, but has no hit targets, semantics, or active tickers.
class _DrawerOverlay extends StatelessWidget {
  const _DrawerOverlay({required this.animation, required this.width, required this.drawer, required this.onClose});

  final Animation<double> animation;
  final double width;
  final Widget drawer;
  final VoidCallback onClose;

  @override
  Widget build(BuildContext context) {
    final scrim = DshSurfaces.of(context).scrim;
    return AnimatedBuilder(
      animation: animation,
      child: RepaintBoundary(child: drawer),
      builder: (context, drawer) {
        final progress = animation.value;
        return Stack(
          fit: StackFit.expand,
          children: [
            Positioned.fill(
              child: IgnorePointer(
                ignoring: progress == 0,
                child: GestureDetector(
                  onTap: onClose,
                  child: ColoredBox(color: scrim.withValues(alpha: scrim.a * progress)),
                ),
              ),
            ),
            Positioned(
              left: 0,
              top: 0,
              bottom: 0,
              width: width,
              child: Visibility(
                visible: progress > 0,
                maintainState: true,
                child: Transform.translate(offset: Offset((progress - 1) * (width + 24), 0), child: drawer!),
              ),
            ),
          ],
        );
      },
    );
  }
}
