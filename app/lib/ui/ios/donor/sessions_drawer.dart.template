/// The donor list options, limited to sorting and private drawer folders.
class _ViewOptionsKey extends ConsumerWidget {
  const _ViewOptionsKey();

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final scope = ref.watch(drawerScopeProvider);
    final filtered = ref.watch(drawerFilterProvider) != DrawerFilter.all;
    final hasFolders = ref.watch(drawerViewProvider.select((v) => v.folders.isNotEmpty));
    if (ref.watch(readListLiveConnectionProvider)?.isLocal != true ||
        scope == null || scope.readOnly || (scope.sessions.isEmpty && !filtered && !hasFolders)) {
      return const SizedBox.shrink();
    }
    return Padding(
      padding: const EdgeInsets.only(right: 10),
      child: DrawerViewButton(onTap: () => _open(context, ref)),
    );
  }

  Future<void> _open(BuildContext context, WidgetRef ref) async {
    final connection = ref.read(readListLiveConnectionProvider);
    final generation = connection?.client.mux.generation;
    final action = await showAppSheet<_ViewAction>(context, builder: (_) => const _ViewOptionsSheet());
    if (!context.mounted || action == null || connection == null ||
        !identical(ref.read(readListLiveConnectionProvider), connection) ||
        connection.client.mux.generation != generation || ref.read(drawerScopeProvider)?.readOnly != false) {
      return;
    }
    switch (action) {
      case _ViewAction.newFolder:
        await createFolderFlow(context, ref);
      case _ViewAction.manageFolders:
        await showManageFolders(context, onEdit: (folder) => editFolderFlow(context, ref, folder));
      case _ViewAction.select:
        ref.read(drawerSelectionProvider.notifier).start();
    }
  }
}

enum _ViewAction { newFolder, manageFolders, select }

