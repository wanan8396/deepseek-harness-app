/// Soft top and bottom edges on the list, so rows fade into the header and
/// the identity bar instead of being cut. At rest nothing is under either fade
/// (the list's own padding is deeper).
class _EdgeFade extends StatelessWidget {
  const _EdgeFade({required this.child});

  final Widget child;

  static const _top = 10.0;
  static const _bottom = 16.0;

  @override
  Widget build(BuildContext context) {
    return ShaderMask(
      blendMode: BlendMode.dstIn,
      shaderCallback: (rect) {
        final h = rect.height <= 0 ? 1.0 : rect.height;
        return LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: const [Color(0x00000000), Color(0xFF000000), Color(0xFF000000), Color(0x00000000)],
          stops: [0, (_top / h).clamp(0.0, 0.5), (1 - _bottom / h).clamp(0.5, 1.0), 1],
        ).createShader(rect);
      },
      child: child,
    );
  }
}

class _SessionList extends ConsumerWidget {
  const _SessionList({required this.onClose, this.now});

  final VoidCallback onClose;
  final DateTime? now;

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final l10n = context.l10n;
    final sessions = ref.watch(sessionsProvider);
    final connection = ref.watch(readListLiveConnectionProvider);
    final identity = ref.watch(readListIdentityProvider);
    final scope = ref.watch(drawerScopeProvider);
    final live = connection?.isLocal == true;
    if (scope == null) {
      if (!live) return const _EmptyState(live: false);
      if (sessions.hasError) {
        return _Centered(
          child: EmptyView(
            compact: true,
            icon: AppIcons.offline,
            title: l10n.shellChatsLoadFailed,
            actionLabel: l10n.commonRetry,
            onAction: () => ref.read(sessionsProvider.notifier).refresh(),
          ),
        );
      }
      return const _SkeletonList();
    }
    if (scope.sessions.isEmpty && ref.watch(drawerViewProvider).folders.isEmpty) {
      if (scope.readOnly) return _Centered(child: Text(readListStatusText(scope.status)));
      return _EmptyState(live: live);
    }

    bool currentHost() => live &&
        identical(ref.read(readListLiveConnectionProvider), connection) &&
        ref.read(readListIdentityProvider) == identity;

    return DrawerConversationList(
      now: now,
      onNewChat: onClose,
      readOnly: scope.readOnly || !live,
      onOpen: (id) {
        if (!currentHost() || ref.read(drawerScopeProvider)?.sessions.any((s) => s.sessionId == id) != true) return;
        ref.read(currentSessionProvider.notifier).select(id);
        onClose();
      },
      onLongPress: (session) {
        final current = ref.read(drawerScopeProvider);
        if (currentHost() && current?.readOnly == false && current!.sessions.any((row) => identical(row, session))) {
          unawaited(_showActions(context, ref, session));
        }
      },
    );
  }

  Future<void> _showActions(BuildContext context, WidgetRef ref, SessionSummary s) async {
    final owner = ref.read(readListLiveConnectionProvider);
    if (owner == null || !owner.isLocal) return;
    final identity = ref.read(readListIdentityProvider);
    final generation = owner.client.mux.generation;
    bool owned() {
      if (!context.mounted || !identical(ref.read(readListLiveConnectionProvider), owner) ||
          owner.client.mux.generation != generation || ref.read(readListIdentityProvider) != identity) {
        return false;
      }
      final scope = ref.read(drawerScopeProvider);
      return scope?.readOnly == false && scope!.sessions.any((row) => row.sessionId == s.sessionId);
    }

    final title = sessionTitle(s);
    final inFolder = ref.read(drawerViewProvider).folderOf.containsKey(s.sessionId);
    final action = await showAppSheet<_SessionAction>(
      context,
      isScrollControlled: true,
      builder: (sheet) => SafeArea(
        top: false,
        child: ConstrainedBox(
          constraints: BoxConstraints(maxHeight: MediaQuery.sizeOf(sheet).height * 0.8),
          child: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                SheetHeader(title),
                SheetGroup(
                  children: [
                    ListTile(
                      leading: const Icon(AppIcons.rename),
                      title: Text(context.l10n.commonRename),
                      onTap: () => Navigator.pop(sheet, _SessionAction.rename),
                    ),
                    ListTile(
                      leading: const Icon(AppIcons.moveToFolder),
                      title: Text(inFolder ? context.l10n.shellMoveToOtherFolder : context.l10n.shellMoveToFolder),
                      onTap: () => Navigator.pop(sheet, _SessionAction.folder),
                    ),
                    ListTile(
                      leading: const Icon(AppIcons.multiSelect),
                      title: Text(context.l10n.shellMultiSelect),
                      onTap: () => Navigator.pop(sheet, _SessionAction.select),
                    ),
                  ],
                ),
                const SizedBox(height: 12),
              ],
            ),
          ),
        ),
      ),
    );
    if (action == null || !owned()) return;
    switch (action) {
      case _SessionAction.folder:
        await moveToFolderFlow(context, ref, [s.sessionId]);
      case _SessionAction.select:
        ref.read(drawerSelectionProvider.notifier).start(s.sessionId);
      case _SessionAction.rename:
        final next = await _askTitle(context, s.title?.trim() ?? '');
        if (!owned() || next == null || next.isEmpty || next == s.title) return;
        try {
          await ref.read(sessionsProvider.notifier).rename(s.sessionId, next);
        } catch (_) {
          if (context.mounted) {
            ScaffoldMessenger.maybeOf(context)?.showSnackBar(SnackBar(content: Text(context.l10n.shellRenameFailed)));
          }
        }
    }
  }

  Future<String?> _askTitle(BuildContext context, String initial) {
    final controller = TextEditingController(text: initial);
    return showAppDialog<String>(
      context: context,
      builder: (dialog) => AlertDialog(
        title: Text(context.l10n.shellRenameChat),
        content: TextField(
          controller: controller,
          autofocus: true,
          maxLength: 80,
          decoration: InputDecoration(hintText: context.l10n.shellChatTitle, counterText: ''),
          onSubmitted: (v) => Navigator.pop(dialog, v.trim()),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(dialog), child: Text(context.l10n.commonCancel)),
          FilledButton(
            onPressed: () => Navigator.pop(dialog, controller.text.trim()),
            child: Text(context.l10n.commonSave),
          ),
        ],
      ),
    ).whenComplete(controller.dispose);
  }
}

enum _SessionAction { rename, folder, select }

/// Loading: a few quiet placeholder rows on the same grid as the real ones,
/// breathing slowly (still under reduced motion).
class _SkeletonList extends StatefulWidget {
  const _SkeletonList();

  @override
  State<_SkeletonList> createState() => _SkeletonListState();
}

class _SkeletonListState extends State<_SkeletonList> with SingleTickerProviderStateMixin {
  late final AnimationController _breath = AnimationController(vsync: this, duration: AppMotion.breath);
  late final Animation<double> _opacity = _breath.drive(
    Tween(begin: 0.55, end: 1.0).chain(CurveTween(curve: AppMotion.std)),
  );

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (AppMotion.reduced(context)) {
      _breath
        ..stop()
        ..value = 1;
    } else if (!_breath.isAnimating) {
      _breath.repeat(reverse: true);
    }
  }

  @override
  void dispose() {
    _breath.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;
    final scheme = Theme.of(context).colorScheme;
    final fill = scheme.onSurface.withValues(alpha: scheme.brightness == Brightness.dark ? 0.09 : 0.07);
    Widget bar(double width, double height) => Container(
      width: width,
      height: height,
      decoration: ShapeDecoration(color: fill, shape: const StadiumBorder()),
    );
    const widths = [0.72, 0.5, 0.64, 0.42, 0.58];
    return Semantics(
      label: l10n.shellLoadingChats,
      child: FadeTransition(
        opacity: _opacity,
        child: LayoutBuilder(
          builder: (context, constraints) {
            final row = constraints.maxWidth - 40;
            return ListView(
              physics: const NeverScrollableScrollPhysics(),
              padding: const EdgeInsets.fromLTRB(20, 4, 20, 16),
              children: [
                Padding(padding: const EdgeInsets.only(top: 19, bottom: 9), child: bar(28, 8)),
                for (final w in widths)
                  SizedBox(
                    height: 44,
                    child: Align(alignment: Alignment.centerLeft, child: bar(row * w, 10)),
                  ),
              ],
            );
          },
        ),
      ),
    );
  }
}

