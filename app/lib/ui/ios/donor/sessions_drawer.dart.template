              onPressed: details,
              padding: const EdgeInsets.all(4),
              constraints: const BoxConstraints.tightFor(width: keySize, height: keySize),
              style: IconButton.styleFrom(tapTargetSize: MaterialTapTargetSize.shrinkWrap),
              icon: localIcon,
            )
          else
            Padding(padding: const EdgeInsets.all(4), child: localIcon),
          Expanded(
            child: Padding(
              padding: const EdgeInsets.symmetric(horizontal: 8),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisSize: MainAxisSize.min,
                children: [
                  Text(l10n.phoneEngineTitle, maxLines: 1, overflow: TextOverflow.ellipsis, style: theme.textTheme.titleSmall),
                  Row(
                    children: [
                      StatusDot(tone: live ? StatusTone.ok : StatusTone.idle, size: 6),
                      const SizedBox(width: 6),
                      Flexible(
                        child: Text(
                          statusLabel,
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: theme.textTheme.bodySmall?.copyWith(color: colors.textTertiary),
                        ),
                      ),
                    ],
                  ),
                ],
              ),
            ),
          ),
          if (onDisconnect case final disconnect?)
            Tooltip(
              message: l10n.commonStop,
              child: Semantics(
                button: true,
                label: l10n.commonStop,
                onTap: disconnect,
                excludeSemantics: true,
                child: SizedBox.square(
                  key: const ValueKey('ios-drawer-disconnect'),
                  dimension: keySize,
                  child: GlassSurface(
                    tier: GlassTier.pill,
                    circle: true,
                    onTap: disconnect,
                    child: Center(child: Icon(AppIcons.power, size: 22, color: theme.colorScheme.onSurface)),
                  ),
                ),
              ),
            ),
        ],
      ),
    );
  }
}

/// Same selection footer as the donor, with its one admitted action: filing
/// the chosen rows in an App-local folder (no Host mutation).
class _MoveSelectionBar extends ConsumerWidget {
  const _MoveSelectionBar({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final l10n = context.l10n;
    final theme = Theme.of(context);
    final enabled = ref.watch(drawerSelectionProvider.select((ids) => ids?.isNotEmpty == true));
    void move() {
      if (ref.read(readListLiveConnectionProvider)?.isLocal != true ||
          ref.read(drawerScopeProvider)?.readOnly != false) return;
      final ids = ref.read(drawerSelectionProvider);
      if (ids != null && ids.isNotEmpty) unawaited(moveToFolderFlow(context, ref, ids.toList()));
    }

    return Padding(
      padding: const EdgeInsets.fromLTRB(10, 6, 10, 10),
      child: Semantics(
        button: true,
        enabled: enabled,
        label: l10n.shellMoveToFolder,
        onTap: enabled ? move : null,
        excludeSemantics: true,
        child: AnimatedOpacity(
          opacity: enabled ? 1 : 0.38,
          duration: AppMotion.of(context, AppMotion.quick),
          child: Material(
            type: MaterialType.transparency,
            child: InkWell(
              onTap: enabled ? move : null,
              customBorder: Squircle.border(AppShape.md),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(AppIcons.moveToFolder, size: 22, color: theme.colorScheme.onSurface),
                  const SizedBox(height: 2),
                  Text(
                    l10n.shellMoveToFolder,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: theme.textTheme.labelSmall?.copyWith(fontSize: 11, height: 1.2),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}
